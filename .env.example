# Copy to .env.local for development. Never commit real values.

# Public address of the site, no trailing slash. Used for links, QR codes and the CSRF origin check.
APP_URL=http://localhost:3000

# The admin panel's own address. In production it is closed without this. In development it shares APP_URL.
STUDIO_URL=

# Set to "staging" on a test copy: marks the site, keeps search engines away, limits email to MAIL_ALLOW
APP_ENV=
# Staging only: who may receive email, separated by commas. A value starting with @ allows a whole domain.
MAIL_ALLOW=

# Postgres connection string. Leave empty in development to use the embedded database in .data/
DATABASE_URL=

# 32 random bytes each. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=
DATA_KEY=

# Protects /api/cron/tick when an external scheduler calls it
CRON_SECRET=
# Set to 1 on a long running server (Railway, a VPS) to run the scheduler inside the app. Leave empty on Vercel.
RUN_SCHEDULER=
# Database connections per server (default 10; use 1 to 3 on serverless)
DB_POOL=

# Outgoing email: use one of the two. Leave both empty in development: messages are printed to the console instead.
# Resend over HTTPS (works on every host)
RESEND_API_KEY=
# or any SMTP server, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Hayyak <no-reply@example.com>"

# How many proxies sit in front of the app (Railway, Render, Vercel = 1). Used to read the client IP safely.
TRUSTED_PROXIES=1
