{
  "name": "hayyak",
  "version": "1.0.0",
  "private": true,
  "description": "Animated invitations, RSVP, attendance and certificates",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run db:migrate && next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "node scripts/use-hooks.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "studio:reset": "tsx scripts/studio-reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
